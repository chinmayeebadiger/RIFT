# Copy to .env for local development. Do not commit .env or real credentials.
RIFT_LOG_LEVEL=INFO
RIFT_WORKSPACE_ROOT=./var/workspaces
RIFT_SANDBOX_BACKEND=docker
RIFT_DATA_DIR=./reports
# Normal recovery requires a locally available immutable staged image digest.
# RIFT_STAGED_DOCKER_IMAGE=registry.example/rift-runner@sha256:<64-hex-digest>
# RIFT_STAGED_DOCKER_REPOSITORY=rift
# Optional API origin for the Next.js rewrite. The local default is
# http://localhost:4000.
# RIFT_API_URL=http://localhost:4000
# AI integration is intentionally disabled in the local MVP. When implemented,
# configure the selected GPT-6 Astra provider through a secret manager or local
# untracked environment file; never commit API keys.
# RIFT_AI_PROVIDER=gpt-6-astra
# RIFT_AI_BASE_URL=
# RIFT_AI_API_KEY=
